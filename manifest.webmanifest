{
  "name": "Family Sudoku",
  "short_name": "Sudoku",
  "description": "Ad-free classic Sudoku for the whole family, with pencil notes, hints and per-player stats.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
